---
import type { Lang } from "../i18n";
import { useTranslations } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

/** Google Analytics 4 measurement ID. The tag loads only after consent. */
const GA_ID = "G-2R1NK24EV6";
---

<div class="consent" id="consent" data-ga-id={GA_ID} hidden>
  <p class="consent-text">
    <span class="consent-prompt">// cookies</span>
    {t("consent.text")}
  </p>
  <div class="consent-actions">
    <button type="button" class="consent-btn" data-consent="denied">
      {t("consent.decline")}
    </button>
    <button
      type="button"
      class="consent-btn consent-btn-primary"
      data-consent="granted"
    >
      {t("consent.accept")}
    </button>
  </div>
</div>

<script>
  const STORAGE_KEY = "analytics-consent";
  const banner = document.getElementById("consent");
  const gaId = banner?.dataset.gaId;

  function readConsent() {
    try {
      return localStorage.getItem(STORAGE_KEY);
    } catch {
      return null;
    }
  }

  function loadAnalytics() {
    if (!gaId || (window as any).gtag) return;
    const w = window as any;
    w.dataLayer = w.dataLayer || [];
    w.gtag = function () {
      w.dataLayer.push(arguments);
    };
    w.gtag("js", new Date());
    w.gtag("config", gaId);

    const script = document.createElement("script");
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${gaId}`;
    document.head.appendChild(script);
  }

  const consent = readConsent();
  if (consent === "granted") {
    loadAnalytics();
  } else if (consent !== "denied" && banner) {
    banner.hidden = false;
  }

  banner?.querySelectorAll<HTMLButtonElement>("[data-consent]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const choice = btn.dataset.consent!;
      try {
        localStorage.setItem(STORAGE_KEY, choice);
      } catch {
        // Storage blocked: respect the choice for this page view only.
      }
      if (choice === "granted") loadAnalytics();
      banner.hidden = true;
    });
  });
</script>

<style>
  .consent {
    position: fixed;
    left: 50%;
    bottom: 1rem;
    transform: translateX(-50%);
    z-index: 100;
    width: min(44rem, calc(100% - 2rem));
    display: flex;
    align-items: center;
    gap: 1rem 1.5rem;
    flex-wrap: wrap;
    padding: 1rem 1.25rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45);
  }
  .consent[hidden] {
    display: none;
  }
  .consent-text {
    flex: 1 1 20rem;
    font-size: 0.85em;
    color: var(--text-muted);
    line-height: 1.5;
  }
  .consent-prompt {
    display: block;
    font-family: var(--mono);
    font-size: 0.85em;
    color: var(--text-faint);
    margin-bottom: 0.25rem;
  }
  .consent-actions {
    display: flex;
    gap: 0.6rem;
    margin-left: auto;
  }
  .consent-btn {
    font-family: var(--mono);
    font-size: 0.8em;
    padding: 0.5rem 0.9rem;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text);
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
  }
  .consent-btn:hover,
  .consent-btn:focus-visible {
    border-color: var(--amber-dim);
  }
  .consent-btn-primary {
    background: var(--amber);
    border-color: var(--amber);
    color: var(--bg);
    font-weight: 600;
  }
  .consent-btn-primary:hover,
  .consent-btn-primary:focus-visible {
    background: var(--gold);
    border-color: var(--gold);
  }
</style>
